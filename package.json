{
  "name": "webdriverio-typescript-framework",
  "version": "0.1.0",
  "type": "module",
  "private": false,
  "description": "A small, maintainable WebdriverIO + TypeScript UI automation showcase.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "demo": "node --import tsx src/demo/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node ./scripts/run-tests.mjs",
    "test:smoke": "node ./scripts/run-tests.mjs smoke",
    "test:regression": "node ./scripts/run-tests.mjs regression",
    "test:cross-browser": "node ./scripts/run-tests.mjs --browsers chrome,firefox",
    "test:headless": "node ./scripts/run-tests.mjs --headless",
    "test:karate": "mvn -f api-tests/karate/pom.xml test",
    "test:api": "node --import tsx --test ./test/demo/server.test.ts",
    "test:unit": "node --import tsx --test ./test/support/diagnostics.test.ts",
    "test:mutation": "stryker run",
    "test:wdio": "wdio run ./wdio.conf.ts"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/typescript-checker": "^10.1.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.0",
    "@wdio/allure-reporter": "^10.1.0",
    "@wdio/cli": "^10.0.0",
    "@wdio/globals": "^10.0.0",
    "@wdio/junit-reporter": "^10.1.0",
    "@wdio/local-runner": "^10.0.0",
    "@wdio/mocha-framework": "^10.0.0",
    "@wdio/spec-reporter": "^10.0.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2"
  }
}
